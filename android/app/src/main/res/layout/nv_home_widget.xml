<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (NvHomeWidget.kt). Colours: values / values-night. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nvw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nvw_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/nvw_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/nvw_dot" />
        <TextView
            android:id="@+id/nvw_pc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Neovarch"
            android:textColor="@color/nvw_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/nvw_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/nvw_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nvw_counts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout style="@style/NvWidgetStat">
            <TextView android:id="@+id/nvw_working" style="@style/NvWidgetNum" android:text="0" />
            <TextView style="@style/NvWidgetLabel" android:text="bekerja" />
        </LinearLayout>
        <LinearLayout style="@style/NvWidgetStat">
            <TextView android:id="@+id/nvw_waiting" style="@style/NvWidgetNum" android:text="0" />
            <TextView style="@style/NvWidgetLabel" android:text="menunggu" />
        </LinearLayout>
        <LinearLayout style="@style/NvWidgetStat">
            <TextView android:id="@+id/nvw_tasks" style="@style/NvWidgetNum" android:text="0" />
            <TextView style="@style/NvWidgetLabel" android:text="tugas" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/nvw_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/nvw_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/nvw_chat" style="@style/NvWidgetButton" android:text="Chat" />
        <TextView android:id="@+id/nvw_voice" style="@style/NvWidgetButton" android:layout_marginStart="6dp" android:text="Suara" />
        <TextView android:id="@+id/nvw_newtask" style="@style/NvWidgetButton.Accent" android:layout_marginStart="6dp" android:text="+ Tugas" />
    </LinearLayout>
</LinearLayout>
