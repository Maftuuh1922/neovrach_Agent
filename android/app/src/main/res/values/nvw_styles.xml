<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NvWidgetStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="NvWidgetNum">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/nvw_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="NvWidgetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/nvw_muted</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="NvWidgetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/nvw_btn</item>
        <item name="android:textColor">@color/nvw_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="NvWidgetButton.Accent">
        <item name="android:background">@drawable/nvw_btn_accent</item>
        <item name="android:textColor">@color/nvw_on_accent</item>
    </style>
</resources>
