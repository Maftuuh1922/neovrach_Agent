<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: neutral field, empty icon. On Android 13+
         MainActivity switches it to LaunchThemeLight when the saved theme is light. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/boot_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/boot_dark</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="LaunchThemeLight" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background_light</item>
        <item name="android:windowSplashScreenBackground">@color/boot_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/boot_light</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/boot_dark</item>
    </style>
</resources>
