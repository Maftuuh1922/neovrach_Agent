# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Neovarch Agent: generated / local-only
build/
**/build/
.dart_tool/
*.iml
/web_build/
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/android/.gradle/
/android/local.properties
/android/key.properties
*.jks
*.keystore

# Landing page (Next.js)
landing/node_modules/
landing/.next/
landing/out/
landing/.vercel/
landing/next-env.d.ts

# Kotlin daemon sessions
.kotlin/
**/.kotlin/

# Neovarch core (Python)
core/**/__pycache__/
core/*.egg-info/
core/.pytest_cache/
core/.venv/

# Neovarch fixed dev/debug signing key: committed on purpose so APKs
# always install over each other (see android/app/build.gradle.kts).
!/android/key.properties
!/android/app/neovarch-signing.keystore
